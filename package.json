{
  "name": "veil-consent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-preserving multi-party consent capabilities for AI processing on Midnight.",
  "scripts": {
    "compile": "compact compile contracts/veil-consent.compact managed",
    "build": "npm run build:web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js && node --import tsx --test tests/*.test.ts",
    "check": "node --check src/*.js && npm run typecheck && npm test",
    "audit": "npm audit --omit=dev --audit-level=high",
    "build:web": "node scripts/build-web.js",
    "demo": "node src/demo.js",
    "dashboard": "node src/server.js",
    "demo:video": "python3 scripts/build-demo-video.py",
    "network:address": "tsx network/address.ts",
    "network:select": "tsx network/network.ts",
    "network:deploy": "tsx network/deploy.ts",
    "network:prove": "tsx network/prove.ts",
    "network:verify": "tsx network/verify.ts",
    "proof-server:start": "docker compose up -d proof-server",
    "proof-server:stop": "docker compose down"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/wallet-sdk-abstractions": "2.1.0",
    "@midnight-ntwrk/wallet-sdk-node-client": "1.1.3",
    "@polkadot/api": "16.5.6",
    "@polkadot/util": "14.0.3",
    "@scure/bip39": "2.4.0",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.10",
    "esbuild-plugin-wasm": "^1.1.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "engines": { "node": ">=22.0.0" },
  "overrides": { "@midnight-ntwrk/onchain-runtime-v3": "3.0.0" }
}

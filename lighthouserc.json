{
  "ci": {
    "collect": {
      "startServerCommand": "node src/server.js",
      "startServerReadyPattern": "VeilConsent dashboard",
      "url": ["http://127.0.0.1:4210/", "http://127.0.0.1:4210/participant.html"],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox --headless" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.7 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "csp-xss": "off",
        "is-on-https": "off"
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./lighthouse-results" }
  }
}

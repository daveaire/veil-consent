pragma language_version 0.23;

import CompactStandardLibrary;

// Privacy model
// -------------
// Public ledger state exposes only lifecycle counters, request and capability
// commitments, expiry, one-time nullifiers, and pseudonymous credentials.
// Document and purpose hashes, the consent threshold, participant decisions,
// approval secrets, organizer authority, and capability secret remain private
// witnesses. A request commitment binds those witnesses to the public expiry
// and enrolled credentials. Capability issuance proves that enough authentic
// private approvals satisfy the hidden threshold; it does not reveal which
// participants approved. Consumption updates public state before the client
// decrypts content, preventing replay. Organizer revocation and participant
// withdrawal can block future use, but cannot erase data already disclosed to
// an AI system or retained outside VeilConsent.

export ledger requestsCreated: Counter;
export ledger capabilitiesIssued: Counter;
export ledger capabilitiesConsumed: Counter;
export ledger revocations: Counter;
export ledger activeRequest: Bytes<32>;
export ledger activeExpiry: Uint<64>;
export ledger requestStatus: Uint<8>;
export ledger activeCapability: Bytes<32>;
export ledger lastResponseNullifier: Bytes<32>;
export ledger usedResponseNullifiers: Set<Bytes<32>>;
export ledger usedCredentials: Set<Bytes<32>>;
export ledger activeCredentialA: Bytes<32>;
export ledger activeCredentialB: Bytes<32>;
export ledger activeCredentialC: Bytes<32>;
export ledger activeRevocationHandleA: Bytes<32>;
export ledger activeRevocationHandleB: Bytes<32>;
export ledger activeRevocationHandleC: Bytes<32>;

constructor() {
  requestStatus = 0;
  activeExpiry = 0;
}

witness privateContentHash(): Bytes<32>;
witness privatePurposeHash(): Bytes<32>;
witness privatePolicySalt(): Bytes<32>;
witness privateThreshold(): Uint<64>;
witness privateOrganizerSecret(): Bytes<32>;
witness privateRequestNonce(): Bytes<32>;
witness privateCredentialA(): Bytes<32>;
witness privateCredentialB(): Bytes<32>;
witness privateCredentialC(): Bytes<32>;
witness privateApprovalSecretA(): Bytes<32>;
witness privateApprovalSecretB(): Bytes<32>;
witness privateApprovalSecretC(): Bytes<32>;
witness privateDecisionA(): Uint<64>;
witness privateDecisionB(): Uint<64>;
witness privateDecisionC(): Uint<64>;
witness privateCapabilitySecret(): Bytes<32>;
witness privateParticipantRevocationSecret(): Bytes<32>;

export circuit createRequest(
  expiry: Uint<64>, credentialA: Bytes<32>, credentialB: Bytes<32>, credentialC: Bytes<32>,
  revocationHandleA: Bytes<32>, revocationHandleB: Bytes<32>, revocationHandleC: Bytes<32>
): Bytes<32> {
  assert(requestStatus == 0 || requestStatus == 3 || requestStatus == 4, "Previous request is still active");
  const threshold = privateThreshold();
  const publicCredentialA = disclose(credentialA);
  const publicCredentialB = disclose(credentialB);
  const publicCredentialC = disclose(credentialC);
  assert(threshold >= 1 && threshold <= 3, "Threshold must be between one and three");
  assert(publicCredentialA != publicCredentialB && publicCredentialA != publicCredentialC && publicCredentialB != publicCredentialC,
    "Consent credentials must be unique");
  assert(!usedCredentials.member(publicCredentialA) && !usedCredentials.member(publicCredentialB) && !usedCredentials.member(publicCredentialC),
    "Consent credentials are one-time and cannot be enrolled again");
  assert(revocationHandleA != revocationHandleB && revocationHandleA != revocationHandleC && revocationHandleB != revocationHandleC,
    "Participant revocation handles must be unique");
  const commitment = requestCommitment(
    privateContentHash(), privatePurposeHash(), privatePolicySalt(), threshold,
    privateOrganizerSecret(), privateRequestNonce(),
    publicCredentialA, publicCredentialB, publicCredentialC,
    revocationHandleA, revocationHandleB, revocationHandleC, expiry
  );
  activeRequest = disclose(commitment);
  activeExpiry = disclose(expiry);
  activeCredentialA = publicCredentialA;
  activeCredentialB = publicCredentialB;
  activeCredentialC = publicCredentialC;
  usedCredentials.insert(publicCredentialA);
  usedCredentials.insert(publicCredentialB);
  usedCredentials.insert(publicCredentialC);
  activeRevocationHandleA = disclose(revocationHandleA);
  activeRevocationHandleB = disclose(revocationHandleB);
  activeRevocationHandleC = disclose(revocationHandleC);
  requestStatus = 1;
  requestsCreated.increment(1);
  return disclose(commitment);
}

export circuit issueCapability(): Bytes<32> {
  assert(requestStatus == 1, "Request is not awaiting consent");
  assert(blockTimeLte(activeExpiry), "Consent request has expired");
  const threshold = privateThreshold();
  const credentialA = privateCredentialA();
  const credentialB = privateCredentialB();
  const credentialC = privateCredentialC();
  assert(credentialA != credentialB && credentialA != credentialC && credentialB != credentialC, "Consent credentials must be unique");
  assert(disclose(credentialA) == activeCredentialA && disclose(credentialB) == activeCredentialB && disclose(credentialC) == activeCredentialC,
    "Private credentials do not match the enrolled participants");
  const decisionA = privateDecisionA();
  const decisionB = privateDecisionB();
  const decisionC = privateDecisionC();
  const approvalSecretA = privateApprovalSecretA();
  const approvalSecretB = privateApprovalSecretB();
  const approvalSecretC = privateApprovalSecretC();
  assert(decisionA <= 1 && decisionB <= 1 && decisionC <= 1, "Consent decisions must be binary");
  if (decisionA == 1) {
    assert(participantCredential(approvalSecretA) == credentialA, "Participant A approval is not authentic");
  }
  if (decisionB == 1) {
    assert(participantCredential(approvalSecretB) == credentialB, "Participant B approval is not authentic");
  }
  if (decisionC == 1) {
    assert(participantCredential(approvalSecretC) == credentialC, "Participant C approval is not authentic");
  }
  assert(decisionA + decisionB + decisionC >= threshold, "Private consent policy is not satisfied");
  const expectedRequest = requestCommitment(
    privateContentHash(), privatePurposeHash(), privatePolicySalt(), threshold,
    privateOrganizerSecret(), privateRequestNonce(),
    credentialA, credentialB, credentialC,
    activeRevocationHandleA, activeRevocationHandleB, activeRevocationHandleC, activeExpiry
  );
  assert(expectedRequest == activeRequest, "Private request data does not match the active commitment");
  const markerA = decisionA == 1
    ? approvalNullifier(approvalSecretA)
    : responseMarker(privateRequestNonce(), privatePolicySalt(), 1);
  const markerB = decisionB == 1
    ? approvalNullifier(approvalSecretB)
    : responseMarker(privateRequestNonce(), privatePolicySalt(), 2);
  const markerC = decisionC == 1
    ? approvalNullifier(approvalSecretC)
    : responseMarker(privateRequestNonce(), privatePolicySalt(), 3);
  assert(!usedResponseNullifiers.member(disclose(markerA)), "Participant A response was already used");
  assert(!usedResponseNullifiers.member(disclose(markerB)), "Participant B response was already used");
  assert(!usedResponseNullifiers.member(disclose(markerC)), "Participant C response was already used");
  usedResponseNullifiers.insert(disclose(markerA));
  usedResponseNullifiers.insert(disclose(markerB));
  usedResponseNullifiers.insert(disclose(markerC));
  const nullifier = responseNullifier(privateRequestNonce(), credentialA, credentialB, credentialC);
  const capability = capabilityFor(activeRequest, privateContentHash(), privatePurposeHash(), privateCapabilitySecret());
  lastResponseNullifier = disclose(nullifier);
  activeCapability = disclose(capability);
  requestStatus = 2;
  capabilitiesIssued.increment(1);
  return disclose(capability);
}

export circuit consumeCapability(): Bytes<32> {
  assert(requestStatus == 2, "Capability is unavailable or already consumed");
  assert(blockTimeLte(activeExpiry), "Capability has expired");
  const capability = capabilityFor(activeRequest, privateContentHash(), privatePurposeHash(), privateCapabilitySecret());
  assert(capability == activeCapability, "Capability does not match this content and purpose");
  requestStatus = 4;
  capabilitiesConsumed.increment(1);
  return disclose(capability);
}

export circuit revokeRequest(): Bytes<32> {
  assert(requestStatus == 1 || requestStatus == 2, "Request cannot be revoked");
  const expectedRequest = requestCommitment(
    privateContentHash(), privatePurposeHash(), privatePolicySalt(), privateThreshold(),
    privateOrganizerSecret(), privateRequestNonce(),
    privateCredentialA(), privateCredentialB(), privateCredentialC(),
    activeRevocationHandleA, activeRevocationHandleB, activeRevocationHandleC, activeExpiry
  );
  assert(expectedRequest == activeRequest, "Only the committed organizer can revoke");
  requestStatus = 3;
  revocations.increment(1);
  return disclose(activeRequest);
}

export circuit withdrawConsent(): Bytes<32> {
  assert(requestStatus == 1 || requestStatus == 2, "Consent cannot be withdrawn for this request");
  const handle = disclose(participantRevocationHandle(privateParticipantRevocationSecret()));
  assert(handle == activeRevocationHandleA || handle == activeRevocationHandleB || handle == activeRevocationHandleC,
    "Caller does not hold an enrolled participant revocation secret");
  requestStatus = 3;
  revocations.increment(1);
  return disclose(activeRequest);
}

export circuit requestCommitment(
  contentHash: Bytes<32>, purposeHash: Bytes<32>, policySalt: Bytes<32>, threshold: Uint<64>,
  organizerSecret: Bytes<32>, requestNonce: Bytes<32>,
  credentialA: Bytes<32>, credentialB: Bytes<32>, credentialC: Bytes<32>,
  revocationHandleA: Bytes<32>, revocationHandleB: Bytes<32>, revocationHandleC: Bytes<32>, expiry: Uint<64>
): Bytes<32> {
  return persistentHash<Vector<14, Bytes<32>>>([
    pad(32, "veil-consent:request:v2"), contentHash, purposeHash, policySalt,
    threshold as Field as Bytes<32>, organizerSecret, requestNonce,
    credentialA, credentialB, credentialC,
    revocationHandleA, revocationHandleB, revocationHandleC, expiry as Field as Bytes<32>
  ]);
}

export circuit responseNullifier(
  requestNonce: Bytes<32>, credentialA: Bytes<32>, credentialB: Bytes<32>, credentialC: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "veil-consent:responses:v1"), requestNonce, credentialA, credentialB, credentialC
  ]);
}

export circuit participantCredential(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "veil-consent:participant:v1"), secret
  ]);
}

export circuit participantRevocationHandle(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "veil-consent:revoke:v1"), secret
  ]);
}

export circuit approvalNullifier(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "veil-consent:approval-null:v1"), secret
  ]);
}

export circuit responseMarker(requestNonce: Bytes<32>, policySalt: Bytes<32>, slot: Uint<8>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "veil-consent:response-marker:v1"), requestNonce, policySalt,
    slot as Field as Bytes<32>
  ]);
}

export circuit capabilityFor(
  request: Bytes<32>, contentHash: Bytes<32>, purposeHash: Bytes<32>, secret: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "veil-consent:capability:v1"), request, contentHash, purposeHash, secret
  ]);
}
